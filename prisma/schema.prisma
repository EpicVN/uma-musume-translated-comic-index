datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"] // Hỗ trợ tìm kiếm toàn văn Postgres
}

// -------------------------------------------------------------
// 1. TÀI KHOẢN TÁC GIẢ & DỊCH GIẢ
// -------------------------------------------------------------
enum CreatorRole {
  ARTIST
  TRANSLATOR
  BOTH
}

model Creator {
  id          String      @id @default(cuid())
  handle      String      @unique // VD: @EDemocraft, @siro_chidori
  name        String      // Display Name hiển thị
  avatarUrl   String?
  profileUrl  String
  role        CreatorRole @default(ARTIST)
  isTarget    Boolean     @default(false) // Dành cho scraper biết có cần theo dõi cron không
  filterTags  String?     // Tag lọc mặc định (VD: #UmaTranslations)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  // Quan hệ
  originalPosts   OriginalPost[]   @relation("ArtistPosts")
  translatedPosts TranslatedPost[] @relation("TranslatorPosts")

  @@index([handle])
  @@index([role])
}

// -------------------------------------------------------------
// 2. BÀI VẼ GỐC CỦA HỌA SĨ (Original Post)
// -------------------------------------------------------------
model OriginalPost {
  id          String   @id @default(cuid())
  tweetId     String   @unique
  tweetUrl    String
  content     String?  @db.Text
  postedAt    DateTime
  mediaCount  Int      @default(1)

  artistId    String
  artist      Creator  @relation("ArtistPosts", fields: [artistId], references: [id], onDelete: Cascade)

  // Series / Nhóm truyện nếu có nhiều kỳ
  seriesId    String?
  series      Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  translations TranslatedPost[]
  tags         PostTag[]

  @@index([artistId])
  @@index([postedAt(sort: Desc)]) // Sắp xếp theo ngày đăng mới nhất siêu tốc
  @@index([seriesId])
}

// -------------------------------------------------------------
// 3. BẢN DỊCH (Translated Post)
// -------------------------------------------------------------
model TranslatedPost {
  id              String       @id @default(cuid())
  tweetId         String       @unique
  tweetUrl        String
  language        String       @default("en") // en, vi, etc.
  content         String?      @db.Text
  postedAt        DateTime

  translatorId    String
  translator      Creator      @relation("TranslatorPosts", fields: [translatorId], references: [id], onDelete: Cascade)

  originalPostId  String
  originalPost    OriginalPost @relation(fields: [originalPostId], references: [id], onDelete: Cascade)

  // Đánh dấu duyệt/chất lượng
  isVerified      Boolean      @default(true) 
  viewCount       Int          @default(0)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([translatorId])
  @@index([originalPostId])
  @@index([postedAt(sort: Desc)])
}

// -------------------------------------------------------------
// 4. HỆ THỐNG NHÃN & NHÂN VẬT (Characters & Tags)
// -------------------------------------------------------------
enum TagCategory {
  CHARACTER // Nhân vật (Manhattan Cafe, Silence Suzuka,...)
  THEME     // Thể loại (Fluff, Comedy, Drama, Romance,...)
  EVENT     // Sự kiện (Summer Camp, Valentine, Derby,...)
}

model Tag {
  id          String       @id @default(cuid())
  slug        String       @unique // manhattan-cafe, rice-shower
  name        String       // Manhattan Cafe
  jpName      String?      // マンハッタンカフェ (Dùng để auto-tag khi cào text gốc)
  category    TagCategory  @default(CHARACTER)
  colorCode   String?      // Mã màu hex hiển thị badge trên web (VD: #4A5568)

  posts       PostTag[]

  createdAt   DateTime     @default(now())

  @@index([slug])
  @@index([category])
  @@index([jpName])
}

// Bảng liên kết n-n giữa Bài đăng gốc và Tag
model PostTag {
  postId      String
  tagId       String
  isManual    Boolean      @default(false) // true: admin gắn bằng tay, false: bot tự nhận diện

  post        OriginalPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag         Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([postId])
  @@index([tagId])
}

// -------------------------------------------------------------
// 5. SERIES / TRUYỆN DÀI KỲ
// -------------------------------------------------------------
model Series {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?        @db.Text
  posts       OriginalPost[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([slug])
}